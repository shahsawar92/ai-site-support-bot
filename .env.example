# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Recommended on Vercel: Upstash Redis (add it from the Vercel Marketplace, which sets KV_REST_API_URL and KV_REST_API_TOKEN).
# Without it, bots live in server memory and can disappear between requests on serverless hosting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
CRAWL_MAX_PAGES=
BUILDS_PER_HOUR=
RATE_LIMIT_PER_HOUR=
